{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:vue/vue3-recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "vue"
  ],
  "rules": {
    "vue/multi-word-component-names": "off",
    "vue/no-v-model-argument": "off",
    "vue/require-default-prop": "off",
    "vue/no-reserved-component-names": "off",
    "no-unused-vars": "warn",
    "no-undef": "off"
  }
}
